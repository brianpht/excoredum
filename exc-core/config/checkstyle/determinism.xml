<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Determinism / hot-path Checkstyle config for exc-core.
  Enforces the forbidden-constructs list from .github/copilot-instructions.md.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Trailing whitespace is not allowed."/>
    </module>

    <module name="RegexpSingleline">
        <property name="format" value="[\u2012\u2013\u2014\u2015]"/>
        <property name="message" value="Em-dash / en-dash is forbidden; use ' - ' (ASCII) instead."/>
    </module>

    <!-- Non-deterministic time sources. -->
    <module name="RegexpSingleline">
        <property name="format" value="System\.(currentTimeMillis|nanoTime)\s*\("/>
        <property name="message" value="Non-deterministic clock forbidden in core; use the leader-assigned timestamp or an injected EpochClock."/>
    </module>

    <!-- Non-deterministic randomness / identifiers. -->
    <module name="RegexpSingleline">
        <property name="format" value="Math\.random\s*\(|UUID\.randomUUID\s*\("/>
        <property name="message" value="Random / GUID generation forbidden in core; identifiers are generated at the Edge."/>
    </module>

    <!-- Allocation-prone string formatting on the hot path. -->
    <module name="RegexpSingleline">
        <property name="format" value="String\.format\s*\("/>
        <property name="message" value="String.format allocates; preformat or use an off-heap buffer."/>
    </module>

    <!-- Streams / lambdas capturing state are banned on the hot path. -->
    <module name="RegexpSingleline">
        <property name="format" value="\.stream\s*\(\s*\)|\.parallelStream\s*\(\s*\)"/>
        <property name="message" value="Java streams are forbidden in core; use primitive iteration."/>
    </module>

    <!-- Blocking / locking primitives are banned on the single-writer hot path. -->
    <module name="RegexpSingleline">
        <property name="format" value="\bsynchronized\b"/>
        <property name="message" value="synchronized is forbidden in core; the single-writer model uses no locks."/>
    </module>

    <module name="TreeWalker">
        <module name="OuterTypeFilename"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>
        <module name="MissingOverride"/>
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="OneStatementPerLine"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="FallThrough"/>
        <module name="ModifierOrder"/>
        <module name="DefaultComesLast"/>

        <!-- Forbidden imports: non-deterministic or allocation-heavy JDK types. -->
        <module name="IllegalImport">
            <property name="illegalClasses" value="
                java.util.Random,
                java.util.HashMap,
                java.util.TreeMap,
                java.util.LinkedList,
                java.util.concurrent.ConcurrentHashMap,
                java.util.concurrent.CompletableFuture,
                java.util.concurrent.ExecutorService,
                java.util.concurrent.BlockingQueue,
                java.util.concurrent.LinkedBlockingQueue,
                java.util.concurrent.ArrayBlockingQueue,
                java.util.concurrent.locks.ReentrantLock,
                java.lang.ThreadLocal,
                java.util.Optional,
                java.math.BigDecimal,
                java.io.File,
                java.time.Instant,
                java.time.LocalDateTime"/>
        </module>
        <module name="IllegalImport">
            <property name="illegalPkgs" value="java.sql, java.util.stream"/>
        </module>
    </module>
</module>
